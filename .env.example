# ============================================================
# Herramienta de Extracción Inteligente y Automatizada
# Archivo de configuración de entorno — EJEMPLO
# Renombrar a .env y personalizar antes de ejecutar
# ============================================================

# --- Selenium / WebDriver ---
# Ruta manual al chromedriver (dejar vacío para uso automático con webdriver-manager)
CHROMEDRIVER_PATH=

# Tiempo máximo de espera implícita en segundos para Selenium (0 recomendado para evitar demoras)
SELENIUM_IMPLICIT_WAIT=0

# Tiempo máximo de espera de página en segundos
SELENIUM_PAGE_LOAD_TIMEOUT=30

# Tiempo máximo para scripts JS en segundos
SELENIUM_SCRIPT_TIMEOUT=15

# Ejecutar Chrome en modo headless (true/false)
SELENIUM_HEADLESS=true

# --- Solicitudes HTTP ---
# Tiempo de espera de conexión en segundos
REQUEST_TIMEOUT=15

# Número máximo de reintentos automáticos
REQUEST_MAX_RETRIES=3

# Pausa entre reintentos en segundos
REQUEST_RETRY_DELAY=2

# Número máximo de redirecciones controladas
REQUEST_MAX_REDIRECTS=5

# --- Extracción (Avance 2) ---
# Páginas máximas por ejecución (límite prudente por defecto)
EXTRACTION_MAX_PAGES=3

# Registros máximos por ejecución
EXTRACTION_MAX_RECORDS=50

# Pausa entre páginas/peticiones en segundos (control de carga)
EXTRACTION_DELAY_S=1.0

# Formato por defecto: json, csv, excel o sqlite
EXTRACTION_DEFAULT_FORMAT=json

# Nombre del parámetro de paginación para APIs REST
EXTRACTION_PAGE_PARAM=page

# Tabla usada por el adaptador SQLite
EXTRACTION_SQLITE_TABLE=dataset

# Directorio de datasets raw/processed (por defecto: data)
DATA_DIR=data

# Límite máximo de tamaño de respuesta en bytes (5 MB por defecto)
REQUEST_MAX_RESPONSE_BYTES=5242880

# User-Agent por defecto (dejar vacío para usar el predeterminado)
DEFAULT_USER_AGENT=

# --- Rutas del proyecto ---
# Directorio donde se guardan los perfiles de sitios analizados
PROFILES_DIR=profiles

# Directorio donde se guardan los reportes de diagnóstico
REPORTS_DIR=reports

# Directorio donde se guardan los logs del sistema
LOGS_DIR=logs

# --- Logging ---
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Seguridad ---
# Respetar robots.txt (true/false) — se recomienda true
RESPECT_ROBOTS_TXT=true

